# Vercel Project Settings > Environment Variables (Production and Preview).
# Node must receive this option before startup; a local dotenv file alone cannot enable it.
NODE_OPTIONS=--experimental-require-module

# Canonical public origin; REQUIRED in production (no path/query).
# Local production testing may use http://127.0.0.1:3010.
APP_ORIGIN=

# Firebase Web app settings (Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account (Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Two existing Firebase Email/Password users: primary admin and backup recovery.
PRIMARY_ADMIN_UID=
PRIMARY_ADMIN_EMAIL=
NEXT_PUBLIC_PRIMARY_ADMIN_EMAIL=
BACKUP_ADMIN_UID=
BACKUP_ADMIN_EMAIL=

# Optional Gmail sender for Contact notices to primary; backup recovery needs no SMTP.
BACKUP_GMAIL_ADDRESS=
BACKUP_GMAIL_APP_PASSWORD=

# Signed Cloudinary preset: allowed_formats jpg,png,webp. App upload limit: 10 MB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Local Turnstile test keys; replace both with production keys before deploying.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
