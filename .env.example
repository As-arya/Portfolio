# Firebase Web app settings (Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account (Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Two Firebase users. Primary uses email/password; backup uses Google sign-in.
PRIMARY_ADMIN_UID=
PRIMARY_ADMIN_EMAIL=
NEXT_PUBLIC_PRIMARY_ADMIN_EMAIL=
BACKUP_ADMIN_UID=
BACKUP_ADMIN_EMAIL=

# Backup Gmail sends contact notices to primary and recovery links to backup.
BACKUP_GMAIL_ADDRESS=
BACKUP_GMAIL_APP_PASSWORD=

# Signed Cloudinary preset: allowed_formats jpg,png,webp; max_file_size 10485760.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Local Turnstile test keys; replace both with production keys before deploying.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
